<resources>
    <color name="mobile_bg">#091516</color>
    <color name="mobile_panel">#122627</color>
    <color name="mobile_teal">#133939</color>
    <color name="mobile_ink">#EDF1E7</color>
    <color name="mobile_muted">#A6BBB1</color>
    <color name="mobile_green">#B8D977</color>
    <color name="mobile_gold">#D9AE51</color>

    <!-- TV theme (referenced in AndroidManifest.xml - DO NOT REMOVE) -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/mobile_bg</item>
        <item name="android:colorAccent">@color/mobile_green</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Mobile theme -->
    <style name="MobileAppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/mobile_bg</item>
        <item name="colorPrimary">@color/mobile_green</item>
        <item name="colorPrimaryDark">@color/mobile_teal</item>
        <item name="colorAccent">@color/mobile_green</item>
        <item name="colorOnPrimary">@color/mobile_ink</item>
        <item name="colorOnSurface">@color/mobile_ink</item>
        <item name="android:colorBackground">@color/mobile_bg</item>
    </style>

    <style name="MobileToolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/mobile_panel</item>
        <item name="titleTextColor">@color/mobile_ink</item>
        <item name="subtitleTextColor">@color/mobile_muted</item>
    </style>

    <style name="MobileBottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/mobile_panel</item>
        <item name="itemIconTint">@color/mobile_bottom_nav_colors</item>
        <item name="itemTextColor">@color/mobile_bottom_nav_colors</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
</resources>